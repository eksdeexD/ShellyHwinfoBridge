<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShellyHwinfoBridge</RootNamespace>
    <AssemblyName>ShellyHwinfoBridge</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellyHwinfoBridge.Core\ShellyHwinfoBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\psu-database.json" Link="psu-database.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="ShellyHwinfoBridge.logo.png" />
    <EmbeddedResource Include="Assets\hwinfo-shared-memory.png" LogicalName="ShellyHwinfoBridge.hwinfo-shared-memory.png" Condition="Exists('Assets\hwinfo-shared-memory.png')" />
  </ItemGroup>

</Project>

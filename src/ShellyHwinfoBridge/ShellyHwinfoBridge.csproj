<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShellyHwinfoBridge</RootNamespace>
    <AssemblyName>ShellyHwinfoBridge</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained single file (carries the .NET 8 runtime; no runtime check in the installer). No trimming: WinForms does not support it. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellyHwinfoBridge.Core\ShellyHwinfoBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\psu-database.json" Link="psu-database.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Cybenetics' terms: the notice on the PSU data ships next to psu-database.json (zip and installer). -->
    <None Include="..\..\PSU-DATA-NOTICE.md" Link="PSU-DATA-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="ShellyHwinfoBridge.logo.png" />
    <EmbeddedResource Include="Assets\hwinfo-shared-memory.png" LogicalName="ShellyHwinfoBridge.hwinfo-shared-memory.png" />
    <EmbeddedResource Include="Assets\hwinfo-gadget.png" LogicalName="ShellyHwinfoBridge.hwinfo-gadget.png" Condition="Exists('Assets\hwinfo-gadget.png')" />
    <EmbeddedResource Include="Assets\hwinfo-reset-preferences.png" LogicalName="ShellyHwinfoBridge.hwinfo-reset-preferences.png" Condition="Exists('Assets\hwinfo-reset-preferences.png')" />
  </ItemGroup>

</Project>
